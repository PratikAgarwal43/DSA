#include <bits/stdc++.h>
using namespace std;

int main() {
	ios_base::sync_with_stdio(false);
	cin.tie(nullptr);
	cout.tie(nullptr);
	int t;
	cin >> t;
	while(t--){
	    int N, M;
	    cin >> N >> M;
	    bool ans = (N*M) % 2 ==0;
	    if (ans) cout << "YES" << '\n';
	    else cout << "NO" << '\n';
	    
	}
	return 0;
	

}
