#include <bits/stdc++.h>
using namespace std;

int main() {
	int n ;
	cin >> n;
	vector<int>num(n);
	int minNum = INT_MAX;
	for (int i = 0 ; i<n ; i++){
	    int a ;
	    cin >> a;
	    num[i]= a;
	    minNum = min(minNum, a);
	}
	long long energy = 0;
	for(int i = 0 ; i < n ; i ++){
	    energy+= num[i]-minNum;
	}
	cout<< energy;
	return 0;

}
