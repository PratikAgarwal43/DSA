#include <bits/stdc++.h>

using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int N, M;
        cin >> N >> M;
        std::vector < int > a(N);
        for (int i = 0; i < N; i++) {
            cin >> a[i];
        }
        sort(a.begin(), a.end());
        long long total = 0;
        int count = 0;
        for (int i = 0; i < N; i++) {
            long long next_people = total + a[i];
            long long handshakes = (next_people * (next_people - 1)) / 2;
            if (handshakes <= M) {
                total = next_people;
                count++;
            }else break;
        }
        cout << count << '\n';
    }
    return 0;
}