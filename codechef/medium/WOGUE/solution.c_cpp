#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        
        string s,r,res="";
        cin >> s >> r;
        for (int i= 0; i<5; i++){
            if (s[i]==r[i]) res+='G';
            else res+='B';
        }
        cout << res << '\n';
    }
    return 0;
}
