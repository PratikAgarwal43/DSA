#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        std::vector<int>a(n) ;
        for(int i= 0; i<n; i++){
            cin >> a[i];
        }
        int sum=0;
        sort(a.begin(),a.end());
        for(int i=1;i <n;i++){
            sum+=a[i];
        }
        cout<<sum<<'\n';
    }
    return 0;
}
