#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n,k;
        cin >> n >> k;
        vector<int>a(n);
        for(int i = 0; i<n ; i++){
            cin >> a[i];
            
        }
        sort(a.rbegin(),a.rend());
        int total = 0;
        for(int i =0 ; i< k; i++){
            total+=a[i];
        }
        cout<< total << '\n';
    }
    return 0;
}
