#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        string s;
        cin >> s;
        int door_opened = 0;
        int streak = 0;
        char prev_char = '\0';
        for(int i = 0; i<n; i++){
            if (s[i]==prev_char){
                streak++;
            }else{
                prev_char = s[i];
                streak =1;
            }
            if (streak == 3){
                door_opened++;
                streak = 0;
                prev_char = '\0';
            }
        }
        cout << door_opened << '\n';
    }
    return 0;
}
