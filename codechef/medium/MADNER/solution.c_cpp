class Solution {
public:
    int findMaximumPairs(const string &students) {
        // write your code here 
        int n = students.size();
        int  count = 0 ;
        int i = 0 ;
        while( i < n-1){
            if(students[i]!= students[i+1]){
                count++;
                i+=2;
            }else{
                i+=1;
            }
        }
        return count;
    }
};
