class Solution {
public:
    int findMaximumPairs(const string &s) {
        // write your code here 
       
        int n = s.size();
        int count = 0;
        for(int i = 0; i<n; i+=2){
            int j = i+1;
            if ((s[i]=='x' && s[j]=='y') || (s[i]=='y' && s[j]=='x')){
                count++;
            }
        }
        return count;}
    
    };
