#include <bits/stdc++.h>

using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    if (t == 1) {
        cout << 1 << "\n";
        return 0;
    }
    std::vector<long long>dp(t+1,0) ;
    dp[0]= 1;
    dp[1]= 1;
    for(int i =2; i<=t; i++){
        dp[i] = dp[i-1] + dp[i-2];
    }
    cout << dp[t] << '\n';
    return 0;
}