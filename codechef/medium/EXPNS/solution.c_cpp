#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int X,Y;
        cin >> X >> Y;
        if (Y*30 <= X) cout << "YES\n";
        else cout<< "NO\n";
    }
    return 0;
}
