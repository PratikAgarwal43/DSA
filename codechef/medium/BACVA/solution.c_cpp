#include <bits/stdc++.h>
using namespace std;

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--)
    {
        string s;
        cin >> s;
        long long sum = 0;
        for (char c : s) {
            sum += (c - '0');
        }
        if (sum % 10 == 0) cout << "Valid\n";
        else cout << "Invalid\n";
    }
    return 0;
}