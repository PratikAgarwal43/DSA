#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        long long n;
        cin >> n;
        long long sum=0;
        while(n){
            sum+=n%10;
            n/=10;
        }
        if (sum%10==0) cout<<"VALID\n";
        else cout << "INVALID\n";
    }
    return 0;
}
