#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int N, S;
        cin >> N >> S;
        int count = 0;
        int cur = 0;
        for(int i = 0; i<N; i++){
            if (cur<S) cur+=4;
            else if ( cur > S) cur-=1;
        }
    }
    return 0;
}
