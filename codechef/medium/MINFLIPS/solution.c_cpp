#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        vector<int> num(n);
        for(int i =0; i<n; i++){
            cin >> num[i];
        }
        if (n%2==1) cout<< -1<< '\n';
        else {
            int count_1=0, count_neq_1=0;
            for (auto i : num){
                if(i==1) count_1++;
                else count_neq_1++;
            }
        }
    }
    return 0;
}
