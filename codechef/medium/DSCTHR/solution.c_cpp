#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int A,B,C;
        cin>>A>>B>>C;
        int res = max({A,B,C});
        cout<< res<<'\n';
        
    }
    return 0;
}
