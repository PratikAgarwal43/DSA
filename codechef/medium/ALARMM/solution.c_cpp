#include <bits/stdc++.h>

using namespace std;

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);

    int t;
    cin >> t;
    while (t--)
    {
        int n, k;
        cin >> n >> k;
        string s;
        cin >> s;

        int alarms = 0;
        int i = 0;

        while (i < n) {

            if (s[i] == '1') {
                alarms++;

                int alarm_pos = min(n - 1, i + k);


                i = alarm_pos + 1;
            } else {
                i++;
            }
        }
        cout << alarms << '\n';
    }
    return 0;
}