#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n, k;
        cin >> n >> k;
        string s;
        cin >> s;
        int count = 0 ,i=0;
        while(i<n){
            if (s[i]=='1') {count++;
            int range = min(n-1, i+k);
            count++;
            i=count + 1;}
        }
        cout << count << '\n';
    }
    return 0;
}
