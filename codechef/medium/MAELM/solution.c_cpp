#include <bits/stdc++.h>
using namespace std;

int main() {
	ios_base:: sync_with_stdio(false);
	cin.tie(nullptr);
	cout.tie(nullptr);
	 int n , m;
	 cin >> n >> m;
	 if (m> n) {
	     cout << "FALSE";
	     return 0;}
	 unordered_map<int, int> freq;
	 for(int i = 0 ; i < n ; i++){
	     for(int j = 0 ; j < n ; j++){
	         long long val;
	         cin >> val;
	         freq[val]++;
	     }
	 }
	 bool possible = true;
	  for(int i = 0 ; i < m ; i++){
	     for(int j = 0 ; j < m ; j++){
	         long long val;
	         cin >> val;
	         if (freq[val]>0)
	         freq[val]--;
	         else
	         possible = false;
	     }
	 }
	 if (possible) cout << "TRUE";
	 else cout<< "FALSE";
	 return 0;

}
