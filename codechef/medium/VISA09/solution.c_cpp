#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int n, s;
    cin >> n >> s;
    vector < int > vec(n);
    for (int i = 0; i < n; i++) {
        cin >> vec[i];
    }
    sort(vec.rbegin(), vec.rend());
    int count = 0, i = 0, curr = 0;
    while(i<n){
        if (curr==s){
            cout << count << "\n";
            return 0;
        }
        else if(s-curr<vec[i]){
            i++;
            continue;
        }
        curr += vec[i];
        count++;
    }
    cout << -1;
    return 0;



}