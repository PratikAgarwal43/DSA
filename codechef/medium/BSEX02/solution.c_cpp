#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        int sum = 0;
        int i =1;
        while(sum<=n){
            sum+=i;
            i++;
        }
        cout<<i-2<<'\n';
    }
    return 0;
}
